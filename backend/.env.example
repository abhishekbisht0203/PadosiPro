# ---------------------------------------------------------------------------
# Copy to `backend/.env` and fill it in. NEVER commit the real .env.
#
#   cp backend/.env.example backend/.env
#
# Every value below is a placeholder. Nothing in this file is a real credential.
# The server validates all of it at boot (src/env.ts) and refuses to start on a
# misconfiguration rather than failing halfway through a request.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database — PostgreSQL hosted on Neon
# ---------------------------------------------------------------------------
# Copy the pooled connection string from Neon: Project Dashboard -> Connect.
# Neon is a managed PostgreSQL service; this application uses plain PostgreSQL
# with the `pg` driver and no ORM, so nothing else is required.
#
# Use the POOLED endpoint (-pooler.) in any deployed environment and for local
# development alike: the pooler is what makes serverless-style scaling work.
#
# Leave DATABASE_SSL on `auto` and it will be inferred — TLS is turned on for
# any URL containing sslmode=... or naming a known managed host. Set it
# explicitly to `true` or `false` to override.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=auto

# Optional: run the test suite against a different database than the app.
# The suite TRUNCATES its own tables (users, profiles, email_otps, user_tasks).
# It refuses to touch a non-localhost database unless you opt in explicitly.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb_test?sslmode=require
# ALLOW_TEST_DB_RESET=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a real one with:  openssl rand -hex 48
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000000000
JWT_EXPIRES_IN=7d

# Password + OTP hashing (bcrypt cost factor).
# 12 is a sensible production value; the test suite lowers it to 4 for speed.
BCRYPT_ROUNDS=12
OTP_BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# Email OTP policy
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# Transactional email — Brevo SMTP
# ---------------------------------------------------------------------------
# The application delivers the verification code over Brevo's SMTP relay.
# This is the real provider; there is no fallback to another one.
#
#   brevo   -> Brevo SMTP relay (the configured path for this project)
#   console -> print the code to stdout, open no socket. Local dev only.
#   smtp    -> the generic SMTP_* block below. Local Mailpit, or another relay.
#
# To create the credentials:
#   1. Brevo (formerly Sendinblue) -> Account -> SMTP & API -> SMTP
#   2. Generate a new SMTP key, e.g. "padosipro-backend", and copy it.
#   3. The SMTP LOGIN is the value shown in that same panel (not your account
#      email). Brevo's login is usually the generated login, not the account
#      address.
#   4. Add and verify the sender email in Brevo -> Senders & Domains. An
#      unverified sender is rejected at delivery time.
#
# BREVO_SMTP_PASSWORD takes a **Brevo SMTP key**. It is NOT the Brevo account
# password and NOT the Brevo API key — neither authenticates against the relay.
#
# Refs:
#   https://help.brevo.com/hc/en-us/articles/7924908994450-Send-transactional-emails-using-Brevo-SMTP
#   https://help.brevo.com/hc/en-us/articles/7959631848850-Create-and-manage-your-SMTP-keys
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=xsmtpsib-placeholder
BREVO_SMTP_PASSWORD=xsmtpsib-placeholder-replace-with-your-smtp-key

# The From identity of the OTP email. Must be a sender verified in Brevo.
MAIL_FROM_EMAIL=no-reply@your-verified-domain.example
MAIL_FROM_NAME=PadosiPro

# Optional. Overrides MAIL_FROM_EMAIL / MAIL_FROM_NAME when set, as a complete
# RFC 5322 address.
# MAIL_FROM=PadosiPro <no-reply@your-verified-domain.example>

# ---------------------------------------------------------------------------
# Generic SMTP — only used when MAIL_MODE=smtp
# ---------------------------------------------------------------------------
# Local Mailpit (docker compose up) or any other relay. Leave these alone when
# using Brevo.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma separated list of allowed CORS origins, or * for any (dev only).
# The mobile app is not subject to CORS; this is for the web build and for
# anyone calling the API from a browser.
CORS_ORIGIN=*

# Rate limits on the credential endpoints, so the suite can raise them.
# The limiter behaviour itself is covered by its own test.
AUTH_RATE_LIMIT_PER_MINUTE=20
REGISTER_RATE_LIMIT_PER_15MIN=10

# Set to true to drop and recreate all tables on migrate (npm run db:reset).
# Never set this against a database you care about.
RESET_DB=false
