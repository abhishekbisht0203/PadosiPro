# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Never commit a real `.env`.
# `docker compose up` works with these defaults out of the box.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Postgres. Inside docker compose the hostname is the service name `postgres`.
DATABASE_URL=postgres://padosipro:padosipro@localhost:5432/padosipro

# Auth. Generate a real one with:  openssl rand -hex 48
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000000000
JWT_EXPIRES_IN=7d

# Password + OTP hashing (bcrypt cost factor)
BCRYPT_ROUNDS=12
OTP_BCRYPT_ROUNDS=10

# Email OTP policy
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Mail delivery.
#   smtp    -> real SMTP server (Mailpit locally, SES/SendGrid/Gmail in prod)
#   console -> print the OTP to stdout instead of sending mail (fast local dev)
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PadosiPro <no-reply@padosipro.local>"

# Comma separated list of allowed CORS origins, or * for any (dev only).
CORS_ORIGIN=*

# Set to true to truncate all tables on migrate (used by `npm run db:reset`).
RESET_DB=false
